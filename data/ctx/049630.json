tle":"주권매매거래정지 (중요한 영업정지)","date":"2024-08-30","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240830900476"},{"id":"D18","kind":"DART 공시","title":"신주인수권부사채(해외신주인수권부사채포함)발행후만기전사채취득","date":"2024-05-29","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240529900323"},{"id":"D19","kind":"DART 공시","title":"매출액또는손익구조30%(대규모법인은15%)이상변동","date":"2024-02-28","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240228900862"},{"id":"D20","kind":"DART 공시","title":"신주인수권부사채(해외신주인수권부사채포함)발행후만기전사채취득","date":"2023-11-29","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20231129900101"},{"id":"D21","kind":"DART 공시","title":"전환사채(해외전환사채포함)발행후만기전사채취득","date":"2023-11-27","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20231127900185"},{"id":"D22","kind":"DART 공시","title":"기타경영사항(자율공시)(특허권 취득)","date":"2023-07-24","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20230724900193"},{"id":"D23","kind":"DART 공시","title":"매출액또는손익구조30%(대규모법인은15%)이상변동","date":"2023-02-17","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20230217900286"},{"id":"R","kind":"DART 사업보고서","title":"사업보고서 (2024.12) 'II. 사업의 내용'","date":"2025-03-20","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250320000963"}]}