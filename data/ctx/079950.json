do?rcpNo=20250919000537"},{"id":"D20","kind":"DART 공시","title":"최대주주변경을수반하는주식담보제공계약체결","date":"2025-06-24","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250624900373"},{"id":"D21","kind":"DART 공시","title":"매출액또는손익구조30%(대규모법인은15%)이상변동","date":"2025-03-14","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250314901408"},{"id":"D22","kind":"DART 공시","title":"매출액또는손익구조30%(대규모법인은15%)이상변동","date":"2024-03-13","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240313902269"},{"id":"D23","kind":"DART 공시","title":"합병등종료보고서(합병)","date":"2024-01-02","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240102000123"},{"id":"D24","kind":"DART 공시","title":"단일판매ㆍ공급계약체결","date":"2023-12-19","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20231219900457"},{"id":"D25","kind":"DART 공시","title":"주요사항보고서(회사합병결정)","date":"2023-10-30","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20231030000394"},{"id":"D26","kind":"DART 공시","title":"매출액또는손익구조30%(대규모법인은15%)이상변동","date":"2023-03-14","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20230314900657"},{"id":"R","kind":"DART 사업보고서","title":"[첨부추가]사업보고서 (2024.12) 'II. 사업의 내용'","date":"2025-03-21","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250321001418"}]}