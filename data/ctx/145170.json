rl":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250331901199"},{"id":"D17","kind":"DART 공시","title":"매출액또는손익구조30%(대규모법인은15%)이상변동","date":"2025-02-14","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250214901202"},{"id":"D18","kind":"DART 공시","title":"타인에대한채무보증결정","date":"2025-01-09","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250109900700"},{"id":"D19","kind":"DART 공시","title":"자기주식처분결과보고서","date":"2024-12-31","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20241231000085"},{"id":"D20","kind":"DART 공시","title":"권리락 (무상증자)","date":"2024-12-17","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20241217900573"},{"id":"D21","kind":"DART 공시","title":"자기주식처분결과보고서","date":"2024-12-12","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20241212000410"},{"id":"D22","kind":"DART 공시","title":"주권매매거래정지 (무상증자)","date":"2024-12-04","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20241204900245"},{"id":"D23","kind":"DART 공시","title":"타법인주식및출자증권취득결정","date":"2024-09-10","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240910900289"},{"id":"D24","kind":"DART 공시","title":"전환청구권행사 (제1회차)","date":"2024-06-25","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240625900228"},{"id":"D25","kind":"DART 공시","title":"전환청구권행사","date":"2024-05-24","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240524900570"},{"id":"R","kind":"DART 사업보고서","title":"[기재정정]사업보고서 (2024.12) 'II. 사업의 내용'","date":"2025-03-31","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250331001613"}]}