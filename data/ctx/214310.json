le":"최대주주변경을수반하는주식담보제공계약체결","date":"2022-01-07","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20220107900663"},{"id":"R","kind":"DART 사업보고서","title":"사업보고서 (2023.12) 'II. 사업의 내용'","date":"2024-04-09","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240409002935"}]}