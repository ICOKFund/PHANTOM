cpNo=20240429900205"},{"id":"D17","kind":"DART 공시","title":"매출액또는손익구조30%(대규모법인은15%)이상변동","date":"2024-02-02","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240202900187"},{"id":"D18","kind":"DART 공시","title":"자기주식취득결과보고서","date":"2023-12-22","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20231222000249"},{"id":"D19","kind":"DART 공시","title":"주요사항보고서(자기주식취득결정)","date":"2023-12-04","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20231204000187"},{"id":"R","kind":"DART 사업보고서","title":"사업보고서 (2024.12) 'II. 사업의 내용'","date":"2025-03-12","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250312000874"}]}