ps://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240320902758"},{"id":"D39","kind":"DART 공시","title":"최대주주변경","date":"2024-03-20","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240320902672"},{"id":"D40","kind":"DART 공시","title":"주요사항보고서(유상증자결정)","date":"2024-02-01","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240201000002"},{"id":"R","kind":"DART 사업보고서","title":"사업보고서 (2024.12) 'II. 사업의 내용'","date":"2025-03-31","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250331003863"}]}