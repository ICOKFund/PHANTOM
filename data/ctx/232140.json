kind":"DART 공시","title":"단기차입금증가결정","date":"2024-07-30","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240730900400"},{"id":"D18","kind":"DART 공시","title":"단일판매ㆍ공급계약체결","date":"2024-07-29","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240729900077"},{"id":"D19","kind":"DART 공시","title":"단일판매ㆍ공급계약체결","date":"2024-04-24","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20240424900103"},{"id":"R","kind":"DART 사업보고서","title":"사업보고서 (2024.12) 'II. 사업의 내용'","date":"2025-03-18","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20250318001423"}]}